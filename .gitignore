# Logs
logs
*.log
npm-debug.log*

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# There are no dependencies, so we ignore package-lock
package-lock.json

# Claude worktrees
.claude/worktrees/

# Scratch pad
tmp/

# Site data
data/

# Secrets
# Only the secrets half of each environment is ignored. The plain
# .env.<environment> files are committed, which is what lets a deployment
# bind them as plain text and the secrets files as encrypted secret text.
.env
.env.*.secrets
src/.kixx/config.json
src/.kixx/secrets.json

