# Non-secret environment variables. This file is committed. The deployment
# tooling binds every value in .env.<environment> as plain text.
#
# Only per-deploy values belong here. A value which varies by environment but
# not by deploy belongs in node-config.js or cloudflare-config.js instead.
#
# Secrets never belong here. The Node.js server reads them from the matching
# .env.<environment>.secrets file. On other target platforms, like Cloudflare
# secret values are managed on the remote target.
#
# No key may appear in both files, or in both a file and the process
# environment; the server rejects a duplicate at startup rather than choosing
# a winner.

# Selects which section of the source config module is loaded. The Node.js
# server uses --environment or NODE_ENV. A Cloudflare deployment derives
# this binding from the deployment tooling and ignores this authored value.
ENVIRONMENT=development

# Trust the X-Forwarded-For header when resolving a request's client IP. Enable
# only when running behind a trusted reverse proxy that sets it; otherwise a
# directly-connected client could spoof its own IP address.
TRUST_PROXY=false

# Identifies a single deploy. The deployment tooling generates this
# binding and rejects it in a dotenv file or as a secret name.
# BUILD_ID=

# The Node.js server port. Defaults to 2026 and is overridable by --port.
# PORT=2026

# Overrides the directory that resolveFilepath() resolves config-relative
# store paths against, in place of src/. Node.js only; unset for every normal
# deployment. Set by local target instances (see README.md) so each instance's
# stores live inside its own directory instead of the shared development data.
# DATA_DIRECTORY=
