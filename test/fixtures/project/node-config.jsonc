{
    "name": "fixture-project",
    // Only what has no default. The store paths are core's defaults, under
    // data/, and DATA_DIRECTORY decides where that is.
    "environments": {
        "test": {
            "LOGGER": { "level": "NONE" },
            // Overrides one default of the visits plugin and leaves the rest.
            "VISITS": { "greeting": "hello from the fixture" }
        },
        // CONTENT_STORE.workingTree is left out, so pages and assets render
        // from the working tree.
        "development": {
            "LOGGER": { "level": "NONE" },
            "VISITS": { "greeting": "hello from the fixture" }
        }
    }
}
