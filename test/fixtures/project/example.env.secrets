# Generated by Kixx from the installed plugin manifests. Do not edit.
# Regenerate it after a manifest changes.
#
# This file is the template for .env.<environment>.secrets, and the list of
# secret names every deployment must provide. Only the names are read: each
# value is a placeholder.

# @required-outside-development
# Declared by Kixx core.
# SHA-256 of the deploy key, as 64 lowercase hex characters. Only the hash is stored on the server.
DEPLOY_KEY_HASH=replace-me

# @optional
# Declared by plugin visits.
# Shows that an optional secret may be absent.
VISITS_OPTIONAL_TOKEN=replace-me

# Declared by plugin panel.
# Shows that a plugin declares a required secret.
PANEL_SIGNING_SECRET=replace-me

# Declared by the app.
# Shows that an app declares its own secrets.
FIXTURE_APP_SECRET=replace-me
