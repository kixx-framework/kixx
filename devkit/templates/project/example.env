# Non-secret environment variables. Copy this file to .env.<environment>
# (for example .env.production), which is committed. The deploy tooling binds
# every value in it as plain text.
#
# Only per-deploy values belong here. A value that varies by environment but
# not by deploy belongs in node-config.jsonc or cloudflare-config.jsonc.
#
# Secrets never belong here. The Node.js server reads them from the matching
# .env.<environment>.secrets file, which git ignores. On Cloudflare, secret
# values are kept on the platform. example.env.secrets lists every secret.
#
# No key may appear in both files, or in a file and the process environment.
# The server refuses a duplicate at startup.

# Trust the X-Forwarded-For header when resolving a request's client IP.
# Enable only behind a trusted reverse proxy that sets it. Otherwise a client
# could spoof its own IP address.
TRUST_PROXY=false

# The Node.js server port. Defaults to 2026. --port overrides it.
# PORT=2026

# Node.js only. The directory the stores live under, in place of the project
# root. By default they are in data/ inside the project.
# DATA_DIRECTORY=

# The deploy tooling sets BUILD_ID and ENVIRONMENT. Don't set either here.
# The Node.js server selects its environment with --environment or NODE_ENV.
