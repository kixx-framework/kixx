{
    "name": "@kixx/dev",
    "version": "7.0.0-alpha.0",
    "license": "MIT",
    "exports": {
        ".": "./kixx-dev.js"
    },
    "publish": {
        "include": [
            "kixx-dev.js",
            "commands/",
            "lib/",
            "templates/",
            "README.md",
            "LICENSE"
        ],
        "exclude": [
            "commands/README.md",
            "test/"
        ]
    },
    "tasks": {
        "test": "deno run -A run-tests.js",
        "lint": "deno run -A run-linter.js",
        "kixx-dev": "deno run -RWNE --allow-sys=homedir --allow-run kixx-dev.js"
    }
}
